{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "title", "type", "status", "applicable_conditions", "inapplicable_conditions", "minimum_baseline", "required_validation", "counterexamples", "source_cases", "evidence"],
  "properties": {
    "id": {"type": "string", "minLength": 2},
    "status": {"enum": ["candidate", "machine_verified", "verified", "deprecated", "demo"]},
    "source_cases": {"type": "array", "items": {"type": "object"}, "minItems": 0},
    "applicable_conditions": {"type": "array", "items": {"type": "string"}},
    "inapplicable_conditions": {"type": "array", "items": {"type": "string"}},
    "counterexamples": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
